{
  "name": "capacitor-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "android": "yarn build && cap run android",
    "android:live": "cap run android --live-reload --host localhost --port 8010 --forwardPorts 8010:8010",
    "build": "wireit",
    "cap:sync": "yarn build && cap sync",
    "dev": "wireit",
    "dev:host": "wireit",
    "ios": "yarn build && cap run ios",
    "ios:live": "cap run ios --live-reload --port 8010",
    "lint": "wireit",
    "lint:fix": "wireit",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "preview": "wireit",
    "typecheck": "wireit"
  },
  "wireit": {
    "build": {
      "command": "vite build",
      "files": [
        "index.html",
        "public/**/*",
        "src/**/*",
        "tsconfig.json",
        "vite.config.ts"
      ],
      "output": [
        "dist/**"
      ],
      "dependencies": [
        "typecheck"
      ]
    },
    "dev": {
      "command": "vite",
      "service": true
    },
    "dev:host": {
      "command": "vite --host",
      "service": true
    },
    "lint": {
      "command": "eslint \"src/**/*.ts\"",
      "files": [
        "src/**/*.ts"
      ]
    },
    "lint:fix": {
      "command": "eslint \"src/**/*.ts\" --fix",
      "files": [
        "src/**/*.ts"
      ]
    },
    "preview": {
      "command": "vite preview",
      "service": true,
      "dependencies": [
        "build"
      ]
    },
    "typecheck": {
      "command": "tsc --noEmit",
      "files": [
        "src/**/*",
        "tsconfig.json"
      ],
      "output": []
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/keyboard": "^8.0.6",
    "@capgo/capacitor-native-navigation": "^8.16.4",
    "@open-wc/scoped-elements": "^3.0.10",
    "@webcomponents/scoped-custom-element-registry": "^0.0.11",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@sl-design-system/rolldown-plugin-css-sheet": "^0.0.2",
    "typescript": "^5.8.3",
    "vite": "^8.3.8",
    "wireit": "^0.14.12"
  }
}
